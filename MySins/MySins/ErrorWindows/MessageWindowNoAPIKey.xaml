<Window x:Class="MySins.MessageWindowNoAPIKey"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MySins"
        mc:Ignorable="d"
        Title="MessageWindowNoAPIKey" Height="200" Width="350"
        ResizeMode="NoResize"
        Background="#f3ba00">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="21*"/>
            <ColumnDefinition Width="216*"/>
            <ColumnDefinition Width="92*"/>
            <ColumnDefinition Width="21*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>

        <TextBlock 
            Grid.Column="1"
            Grid.Row="1"
            Text="error: No access to API key"
            FontFamily="Consolas"
            TextWrapping="Wrap"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            FontSize="22" Grid.ColumnSpan="2" Margin="0,10,0,0" Grid.RowSpan="2"/>

        <TextBlock 
            Grid.Column="1"
            Grid.Row="2"
            Text="For more detailed information, please refer to our repository on GitHub:"
            FontFamily="Consolas"
            TextWrapping="Wrap"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            FontSize="15" Grid.ColumnSpan="2" Margin="0,20,0,0" Grid.RowSpan="2"/>

        <TextBlock 
            Grid.Column="1"
            Grid.Row="3"
            TextWrapping="Wrap"
            TextAlignment="Center"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="15"
            FontFamily="Consolas" Margin="138,41,0,0" Grid.RowSpan="2">
            <Hyperlink RequestNavigate="Hyperlink_RequestNavigate" NavigateUri="https://github.com/bodunch/My_Sins_With_AI">link</Hyperlink>
        </TextBlock>
    </Grid>
</Window>
